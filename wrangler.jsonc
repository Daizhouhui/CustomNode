{
  "name": "customnode-private",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_OWNER": "DaiZhouHui",
    "GITHUB_REPOSITORY": "CustomNode",
    "GITHUB_REF": "main",
    "APP_HOST": "manager.example.com",
    "SUBSCRIPTION_HOST": "sub.example.com",
    "SUBSCRIPTION_ORIGIN": "https://sub.example.com"
  }
}
