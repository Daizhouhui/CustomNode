{
  "name": "customnode-private",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "manager.knny.dpdns.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "GITHUB_OWNER": "DaiZhouHui",
    "GITHUB_REPOSITORY": "CustomNode",
    "GITHUB_REF": "main",
    "APP_HOST": "manager.knny.dpdns.org"
  }
}
